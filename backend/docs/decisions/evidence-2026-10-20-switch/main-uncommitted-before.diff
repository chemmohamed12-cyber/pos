+#   Windows: PG_DUMP_BIN=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe   PG_RESTORE_BIN=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
+#   Linux:   PG_DUMP_BIN=/usr/bin/pg_dump                                         PG_RESTORE_BIN=/usr/bin/pg_restore
