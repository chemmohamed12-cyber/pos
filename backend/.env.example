# Local dev only. Copy to .env and adjust.
# PORT must stay 3500 — frontend/vite.config.ts hardcodes its dev-server
# proxy target to http://localhost:3500; a different backend port here
# means the frontend simply can't reach the API.
NODE_ENV=development
PORT=3500
DB_HOST=localhost
DB_PORT=5432
DB_USER=daii
DB_PASSWORD=daii_dev_only
DB_NAME=daii_dev

# --- Production (cPanel) note — see PRODUCTION_DEPLOYMENT_GUIDE.md ---
# Do NOT set DB_HOST=localhost in production. Node.js 17+ resolves
# "localhost" to the IPv6 loopback (::1) first; if Postgres/pg_hba.conf
# on the host isn't set up for an IPv6 connection, this fails with
# "no pg_hba.conf entry for host ::1, ...". Use the literal IPv4 address
# instead:
#   DB_HOST=127.0.0.1
# This file (.env) is server-side only — it must never ship inside a
# release ZIP and must never be overwritten by extracting one.

# Authentication (JWT). The values below are dev-only defaults baked into
# configuration.schema.ts and are used automatically if these vars are
# omitted in development — listed here so production deployments know
# what to override. When NODE_ENV=production, configuration.schema.ts
# REJECTS these exact default strings and requires a real secret of at
# least 32 characters for each (fails closed at startup, not silently).
JWT_ACCESS_SECRET=daii_dev_jwt_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=daii_dev_jwt_refresh_secret_do_not_use_in_prod
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Media / Object Storage — where the local-filesystem storage adapter
# writes uploaded files (waybill images, etc.). Relative to backend/ cwd.
MEDIA_STORAGE_PATH=./storage/media

# Encrypts external-integration pairing credentials (e.g. the QR Store
# connector's pairing token) at rest, AES-256-GCM key material (32+ chars).
# Same fail-closed-in-production rule as the JWT secrets above.
INTEGRATION_ENCRYPTION_KEY=daii_dev_integration_encryption_key_do_not_use_in_prod

# Multi-Company Phase 3 V7, Area 3 (Database Registry). Encrypts per-Company
# database connection credentials at rest — deliberately a separate key from
# INTEGRATION_ENCRYPTION_KEY above, so one secret domain's compromise does
# not expose the other. Same fail-closed-in-production rule.
DATABASE_CREDENTIAL_ENCRYPTION_KEY=daii_dev_database_credential_encryption_key_do_not_use_in_prod

# ADR-051 (Month-End Closing / Black Box). Optional — generate a real
# Ed25519 keypair per installation (never reuse this file's value); the app
# boots fine with these unset, Closing Snapshot generation fails closed
# until they are provisioned. PKCS8/DER private key, base64.
CLOSING_SNAPSHOT_SIGNING_PRIVATE_KEY=
CLOSING_SNAPSHOT_SIGNING_KID=
