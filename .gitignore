# Dependencies
node_modules/

# Build output
dist/
build/
# ...but the release build tooling is source, not build output (H3 release readiness): it must be in a fresh checkout / CI.
!backend/tools/build/

# Environment / secrets
.env
.env.*
!.env.example

# Logs and ad-hoc verification output (including dated rotations, e.g.
# stderr.log.20260831)
*.log
*.log.*
*.out
backend-start*.out
backend-verify*.out
e2e-vite-*.log

# Uploaded/generated storage (runtime artifacts, not source)
backend/storage/
backend/tmp/

# Redundant node_modules snapshots taken during an incident recovery — same
# regenerable dependency tree as node_modules/, just under a different name
# so the rule above doesn't already catch it (exists under both backend/ and
# the backend.prev-* historical snapshot).
node_modules.incident-backup*/

# Test coverage output (generated by `jest --coverage`, not source)
coverage/

# Deployment logs (operational/runtime, not source) — the incoming/*.zip and
# manifests/ under backend/_deploy are deliberately NOT ignored here; they
# are named release/deployment artifacts, not generated build noise.
backend/_deploy/logs/

# OS/editor cruft
.DS_Store
Thumbs.db

# Reference source material — not application code, may contain sensitive
# real business data (see note in session log). Tracked separately if ever
# needed; excluded from the app repo by default.
احمد/
احمد.zip

# CI step logs (regenerated by tools/ci/ci.sh)
backend/ci-output/

# D-05 (2026-10-11): runtime/backup trees that were mirrored from the host into Git. Authoritative sources: backend/, frontend/, the release engine output (see backend/docs/decisions/test-03/D-05-CLEANUP-RECORD-2026-10-11.md). Recoverable from tag pre-hygiene-2026-10-11.
backend.prev-*/
_frontend-backup-*/
backend/_deploy/
backend/public.pre-v1.0.3/
backend/archive/
